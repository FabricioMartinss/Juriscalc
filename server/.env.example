# Postgres. Em produção é o banco gerenciado (Neon) — a connection string
# fica nas variáveis de ambiente do serviço da API no host, não neste arquivo.
# Aqui só pra rodar local; string do Neon aceita ?sslmode=require.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/juriscalcsp"

# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Origens do front que podem chamar esta API (separadas por vírgula).
ALLOWED_ORIGINS="http://localhost:3000,https://juriscalcsp.com,https://www.juriscalcsp.com"

# Domínio do cookie de sessão. Em produção, use o domínio raiz com ponto na
# frente (".juriscalcsp.com") pra funcionar em juriscalcsp.com e
# api.juriscalcsp.com ao mesmo tempo. Em dev local, deixe vazio.
COOKIE_DOMAIN=""

# Endereço do SITE (não desta API) — é a base dos links que vão por e-mail,
# como o de redefinir senha. Vazio cai na primeira origem de ALLOWED_ORIGINS.
SITE_URL="http://localhost:3000"

PORT="4000"
NODE_ENV="development"

# Chave da API da Anthropic — usada só para extrair dados de PDF/imagem de
# processo enviados no site (rota /api/documentos/extrair). Gerar em
# https://console.anthropic.com/settings/keys. Em produção, configurar nas
# variáveis de ambiente do serviço da API no host — sem ela a rota dá 500.
ANTHROPIC_API_KEY=""

# Modelo usado na extração. Pode trocar sem redeploy de código.
ANTHROPIC_MODEL="claude-sonnet-5"

# Envio da caixa de dúvidas/problemas (aba Perfil > Suporte), rota
# /api/suporte. Por API HTTP da Resend (https://resend.com), não SMTP -- o
# envio por SMTP (Gmail) ficou pendurado pra sempre em produção, porta de
# saída provavelmente bloqueada pelo host. Sem RESEND_API_KEY ou sem
# SUPORTE_EMAIL_ORIGEM a rota responde 503 em vez de quebrar o servidor --
# dá pra rodar o resto do app sem configurar isto.
#
# RESEND_API_KEY: gerar em https://resend.com/api-keys (free até 3.000
# e-mails/mês, mais que suficiente pra um formulário de contato).
RESEND_API_KEY=""

# SUPORTE_EMAIL_ORIGEM: o "de" do e-mail. Precisa ser um endereço de domínio
# VERIFICADO na Resend (https://resend.com/domains, registros DNS no
# domínio) -- diferente do SMTP antigo, não dá pra mandar "de" um Gmail
# alheio. Ex.: "suporte@juriscalcsp.com" (o "sub"domínio de e-mail não
# precisa ser o mesmo texto do destino abaixo).
SUPORTE_EMAIL_ORIGEM=""

# Pra onde a mensagem do formulário de suporte é enviada (esse pode ser
# qualquer caixa, não precisa ser do domínio verificado). Pode ficar vazio
# em dev -- o código usa suporte.juriscalcsp@gmail.com como padrão.
SUPORTE_EMAIL_DESTINO="suporte.juriscalcsp@gmail.com"
